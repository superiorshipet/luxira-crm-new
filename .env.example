LUXIRA_LOCAL_SQL_PASSWORD=replace-with-a-local-strong-password
LUXIRA_LOCAL_REDIS_PASSWORD=replace-with-a-local-strong-password

# Use only the isolated containers from compose.local.yml.
ConnectionStrings__LuxiraSqlServer=Server=localhost,14339;Database=LuxiraLocal;User Id=sa;Password=replace-with-a-local-strong-password;TrustServerCertificate=True;Encrypt=True
ConnectionStrings__LuxiraRedis=localhost:16379,password=replace-with-a-local-strong-password,abortConnect=false
