        {
          "name": "Discover API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "operationId: Platform_GetApiDiscovery"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery returns its OpenAPI import URL', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.openApiUrl).to.include('/swagger/v1/swagger.json');",
                  "});"
                ]
              }
            }
          ]
        },
